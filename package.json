{
  "name": "lydias-essence",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @lydias-essence/storefront dev",
    "dev:admin": "pnpm --filter @lydias-essence/admin dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:storefront": "pnpm --filter @lydias-essence/storefront build",
    "build:admin": "pnpm --filter @lydias-essence/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "cf:deploy:admin": "pnpm --filter @lydias-essence/admin cf:deploy",
    "cf:deploy:storefront": "pnpm --filter @lydias-essence/storefront cf:deploy",
    "cf:deploy": "pnpm cf:deploy:storefront && pnpm cf:deploy:admin"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
