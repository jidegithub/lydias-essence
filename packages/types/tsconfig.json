{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,   // or full build if you want
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler", // or "node16" / "nodenext"
    "strict": true
  },
  "include": ["src"]
}
